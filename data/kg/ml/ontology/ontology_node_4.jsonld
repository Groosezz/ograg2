{
  "@context": {
    "ns1": "http://asiainfo.com/",
    "odlm": "http://asiainfo.com/odlm#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "odlm:ReinforcementLearning",
      "@type": "owl:Class",
      "rdfs:label": "强化学习",
      "rdfs:subClassOf": {
        "@id": "odlm:LearningMethod"
      },
      "name": "Reinforcement Learning",
      "description": "强化学习（Reinforcement Learning, RL）是一种基于奖惩反馈机制的学习方式，代理（agent）通过与环境的交互学习策略，以最大化长期累积奖励。代理在每一步选择动作，接收环境给出的奖励信号，并据此调整策略。强化学习无需预设输入输出对，适用于处理连续决策问题，常见应用包括机器人控制、游戏AI（如 AlphaGo）、自动驾驶和智能交易等领域。",
      "learningParadigm": "基于奖惩反馈",
      "requiresLabels": false,
      "interactsWithEnvironment": true,
      "usesRewardSignal": true,
      "hasHighValue": true,
      "includesAlgorithms": true,
      "maximize": {
        "@id": "odlm:CumulativeReward"
      },
      "solve": {
        "@id": "odlm:SequentialDecisionMaking"
      },
      "apply": [
        {
          "@id": "odlm:RobotControl"
        },
        {
          "@id": "odlm:GameAI"
        },
        {
          "@id": "odlm:AutonomousDriving"
        },
        {
          "@id": "odlm:AlgorithmicTrading"
        }
      ],
      "learn": [
        {
          "@id": "odlm:Policy"
        }
      ]
    },
    {
      "@id": "odlm:QLearning",
      "@type": "owl:Class",
      "rdfs:label": "Q-Learning",
      "rdfs:subClassOf": {
        "@id": "odlm:ReinforcementLearningAlgorithm"
      },
      "name": "Q-Learning",
      "description": "Q-Learning 是一种无模型的值函数方法，通过学习状态-动作对的 Q 值来构建最优策略。每次交互后，Q 值根据即时奖励和未来最优估计进行更新，直至收敛。该方法适用于离散状态和动作空间，结构简单、直观，但难以扩展至连续或高维场景，且在复杂任务中计算成本高。",
      "computationalComplexity": "高",
      "supportsDiscreteActionSpace": true,
      "supportsDiscreteStateSpace": true,
      "supportsContinuousActionSpace": false,
      "modelFree": true,
      "scalability": "低",
      "updateRule": "基于即时奖励和未来最优估计",
      "update": {
        "@id": "odlm:QValue"
      },
      "build": {
        "@id": "odlm:OptimalPolicy"
      },
      "estimate": {
        "@id": "odlm:QValue"
      }
    },
    {
      "@id": "odlm:ActorCritic",
      "@type": "owl:Class",
      "rdfs:label": "Actor-Critic",
      "rdfs:subClassOf": {
        "@id": "odlm:ReinforcementLearningAlgorithm"
      },
      "name": "Actor-Critic",
      "description": "Actor-Critic 方法结合策略优化（Actor）与价值评估（Critic），由策略网络输出动作概率分布，价值网络评估当前策略的优劣。Critic 通过时间差分误差（TD误差）为 Actor 提供优化方向，使训练更稳定。该方法支持连续动作空间，但在实际应用中可能出现高方差或不稳定问题。",
      "trainingStability": "中等",
      "trainingVariance": "高",
      "usesPolicyNetwork": true,
      "usesValueNetwork": true,
      "usesTDError": true,
      "supportsContinuousActionSpace": true,
      "optimize": {
        "@id": "odlm:Policy"
      },
      "use": {
        "@id": "odlm:TimeDifferenceError"
      },
      "evaluate": [
        {
          "@id": "odlm:PolicyQuality"
        },
        {
          "@id": "odlm:ValueFunction"
        }
      ],
      "provide": {
        "@id": "odlm:OptimizationDirection"
      }
    },
    {
      "@id": "odlm:TRPO",
      "@type": "owl:Class",
      "rdfs:label": "置信域策略优化",
      "rdfs:subClassOf": {
        "@id": "odlm:ReinforcementLearningAlgorithm"
      },
      "name": "Trust Region Policy Optimization",
      "description": "置信域策略优化（Trust Region Policy Optimization, TRPO）引入 KL 散度约束，限制策略在更新过程中的变化幅度，从而提高收敛稳定性。尽管 TRPO 在高维任务中表现优越，但优化过程复杂，计算代价较高，不适合大规模部署。",
      "computationalComplexity": "高",
      "convergenceStability": "高",
      "usesKLDivergenceConstraint": true,
      "suitableForHighDimensionalTasks": true,
      "deploymentSuitability": "低",
      "constrain": {
        "@id": "odlm:PolicyUpdate"
      },
      "limit": {
        "@id": "odlm:PolicyChange"
      }
    },
    {
      "@id": "odlm:PPO",
      "@type": "owl:Class",
      "rdfs:label": "近端策略优化",
      "rdfs:subClassOf": {
        "@id": "odlm:ReinforcementLearningAlgorithm"
      },
      "name": "Proximal Policy Optimization",
      "description": "近端策略优化（Proximal Policy Optimization, PPO）是对 TRPO 的简化改进，使用“剪切”机制控制策略更新范围，兼顾性能与计算效率。PPO 训练稳定、易于实现，成为当前强化学习中应用最广泛的策略优化方法之一，广泛用于游戏AI、机器人控制和自动驾驶仿真等任务。",
      "trainingStability": "高",
      "popularity": "高",
      "implementationComplexity": "低",
      "widelyUsed": true,
      "usesClippingMechanism": true,
      "clip": {
        "@id": "odlm:PolicyUpdate"
      },
      "balance": {
        "@id": "odlm:PerformanceAndEfficiency"
      },
      "apply": [
        {
          "@id": "odlm:GameAI"
        },
        {
          "@id": "odlm:RobotControl"
        },
        {
          "@id": "odlm:AutonomousDriving"
        }
      ]
    },
    {
      "@id": "odlm:DQN",
      "@type": "owl:Class",
      "rdfs:label": "深度 Q 网络",
      "rdfs:subClassOf": {
        "@id": "odlm:ReinforcementLearningAlgorithm"
      },
      "name": "Deep Q-Network",
      "description": "深度 Q 网络（Deep Q-Network, DQN）将 Q-Learning 与深度神经网络结合，用于高维状态空间的策略学习。DQN 通过经验回放和目标网络机制提升训练稳定性，成功应用于图像输入下的控制任务（如 Atari 游戏）。",
      "sampleEfficiency": "中等",
      "handlesHighDimensionalStateSpace": true,
      "usesTargetNetwork": true,
      "usesExperienceReplay": true,
      "inputModality": "图像",
      "supportsDiscreteActionSpace": true,
      "supportsContinuousActionSpace": false,
      "combine": {
        "@id": "odlm:DeepNeuralNetwork"
      },
      "stabilize": {
        "@id": "odlm:Training"
      },
      "apply": {
        "@id": "odlm:GameAI"
      }
    }
  ]
}