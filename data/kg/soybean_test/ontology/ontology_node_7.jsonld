        "herbicides": {
          "@type": "cropCult:HerbicideList",
          "name": "pre-emergence herbicides",
          "quantity": "as per label instructions",
          "stage": "pre-emergence"
        }
      },
      "needs_irrigation_schedule": {
        "@type": "cropCult:IrrigationRequirement",
        "quantity": "as per crop requirement",
        "stage_of_application": "critical growth stages like seedling, flowering, and pod filling"
      },
      "needs_disease_treatements": {
        "@type": "cropCult:DiseaseTreatements",
        "disease_name": "various diseases",
        "disease_symptoms": "as per occurrence",
        "disease_control": {
          "@type": "cropCult:HerbicideList",
          "name": "various control measures",
          "quantity": "as per label instructions",
          "stage": "as per occurrence"
        }
      },
      "needs_pest_treatements": {
        "@type": "cropCult:PestTreatements",
        "pest_name": "various pests",
        "pest_symptoms": "as per occurrence",
        "pest_control": {
          "@type": "cropCult:PesticideList",
          "name": "various control measures",
          "quantity": "as per label instructions",
          "stage": "as per occurrence"
        }
      },
      "harvesting_guidelines_are": "Harvesting should be timed with the initiation of pod color change when moisture content is around 14-16%.",
      "storage_guidelines_are": "Storage should be in a cool, aerated, insect-free environment with soybean bags kept upright and stacked up to 4-5 bags of not more than 5 feet height on a platform to maintain seed viability and germination."
    }
  ]
}