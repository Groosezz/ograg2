@prefix odlm: <http://asiainfo.com/odlm#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://asiainfo.com/odlm> a owl:Ontology .

odlm:GraphNeuralNetwork a owl:Class ;
    rdfs:label "GraphNeuralNetwork" ;
    rdfs:subClassOf odlm:SemiSupervisedLearningAlgorithm .

odlm:SelfTraining a owl:Class ;
    rdfs:label "SelfTraining" ;
    rdfs:subClassOf odlm:SemiSupervisedLearningAlgorithm .

odlm:acousticModelType a owl:DatatypeProperty ;
    rdfs:label "acousticModelType" ;
    rdfs:domain odlm:SpeechRecognition ;
    rdfs:range xsd:string .

odlm:actionSpaceType a owl:DatatypeProperty ;
    rdfs:label "actionSpaceType" ;
    rdfs:domain odlm:RobotControl ;
    rdfs:range xsd:string .

odlm:activationFunction a owl:DatatypeProperty ;
    rdfs:label "activationFunction" ;
    rdfs:domain odlm:NeuralNetwork,
        odlm:SparseCoding ;
    rdfs:range xsd:string .

odlm:adjust a owl:ObjectProperty ;
    rdfs:label "adjust" ;
    rdfs:domain odlm:Agent ;
    rdfs:range odlm:Policy .

odlm:annotationCost a owl:DatatypeProperty ;
    rdfs:label "annotationCost" ;
    rdfs:domain odlm:MedicalImageAnalysis ;
    rdfs:range xsd:string .

odlm:anomalyThreshold a owl:DatatypeProperty ;
    rdfs:label "anomalyThreshold" ;
    rdfs:domain odlm:AnomalyDetection ;
    rdfs:range xsd:double .

odlm:applicationDomain a owl:DatatypeProperty ;
    rdfs:label "applicationDomain" ;
    rdfs:domain odlm:Classification,
        odlm:Regression ;
    rdfs:range xsd:string .

odlm:apply a owl:ObjectProperty ;
    rdfs:label "apply" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( odlm:CoTraining odlm:SupervisedLearning odlm:SemiSupervisedLearning odlm:UnsupervisedLearning odlm:ReinforcementLearning ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( odlm:SpeechRecognition odlm:DataCompression odlm:ImageRecognition odlm:Classification odlm:AutonomousDriving odlm:GeneAnalysis odlm:WebPageClassification odlm:NaturalLanguageProcessing odlm:GameAI odlm:AnomalyDetection odlm:AlgorithmicTrading odlm:Regression odlm:TextAnalysis odlm:RecommendationSystem odlm:MedicalImageAnalysis odlm:CustomerSegmentation odlm:RobotControl ) ] .

odlm:balance a owl:ObjectProperty ;
    rdfs:label "balance" ;
    rdfs:domain odlm:PPO ;
    rdfs:range odlm:PerformanceAndEfficiency .

odlm:bandwidth a owl:DatatypeProperty ;
    rdfs:label "bandwidth" ;
    rdfs:domain odlm:DensityEstimation ;
    rdfs:range xsd:double .

odlm:build a owl:ObjectProperty ;
    rdfs:label "build" ;
    rdfs:domain odlm:QLearning ;
    rdfs:range odlm:OptimalPolicy .

odlm:businessGoal a owl:DatatypeProperty ;
    rdfs:label "businessGoal" ;
    rdfs:domain odlm:CustomerSegmentation ;
    rdfs:range xsd:string .

odlm:classCount a owl:DatatypeProperty ;
    rdfs:label "classCount" ;
    rdfs:domain odlm:Classification ;
    rdfs:range xsd:int .

odlm:clip a owl:ObjectProperty ;
    rdfs:label "clip" ;
    rdfs:domain odlm:PPO ;
    rdfs:range odlm:PolicyUpdate .

odlm:clusterCount a owl:DatatypeProperty ;
    rdfs:label "clusterCount" ;
    rdfs:domain odlm:Clustering ;
    rdfs:range xsd:int .

odlm:clusterShapeAssumption a owl:DatatypeProperty ;
    rdfs:label "clusterShapeAssumption" ;
    rdfs:domain odlm:Clustering ;
    rdfs:range xsd:string .

odlm:coldStartHandling a owl:DatatypeProperty ;
    rdfs:label "coldStartHandling" ;
    rdfs:domain odlm:RecommendationSystem ;
    rdfs:range xsd:boolean .

odlm:combine a owl:ObjectProperty ;
    rdfs:label "combine" ;
    rdfs:domain odlm:DQN ;
    rdfs:range odlm:DeepNeuralNetwork .

odlm:compressionRatio a owl:DatatypeProperty ;
    rdfs:label "compressionRatio" ;
    rdfs:domain odlm:DataCompression ;
    rdfs:range xsd:double .

odlm:computationalComplexity a owl:DatatypeProperty ;
    rdfs:label "computationalComplexity" ;
    rdfs:domain odlm:Algorithm,
        odlm:QLearning,
        odlm:TRPO ;
    rdfs:range xsd:string .

odlm:confidenceThreshold a owl:DatatypeProperty ;
    rdfs:label "confidenceThreshold" ;
    rdfs:domain odlm:CoTraining ;
    rdfs:range xsd:double .

odlm:constrain a owl:ObjectProperty ;
    rdfs:label "constrain" ;
    rdfs:domain odlm:TRPO ;
    rdfs:range odlm:PolicyUpdate .

odlm:contentStructure a owl:DatatypeProperty ;
    rdfs:label "contentStructure" ;
    rdfs:domain odlm:WebPageClassification ;
    rdfs:range xsd:string .

odlm:contextAwareness a owl:DatatypeProperty ;
    rdfs:label "contextAwareness" ;
    rdfs:domain odlm:NaturalLanguageProcessing ;
    rdfs:range xsd:boolean .

odlm:convergenceGuarantee a owl:DatatypeProperty ;
    rdfs:label "convergenceGuarantee" ;
    rdfs:domain odlm:ReinforcementLearningAlgorithm,
        odlm:SemiSupervisedLearningAlgorithm,
        odlm:SupervisedLearningAlgorithm,
        odlm:UnsupervisedLearningAlgorithm ;
    rdfs:range xsd:boolean .

odlm:convergenceStability a owl:DatatypeProperty ;
    rdfs:label "convergenceStability" ;
    rdfs:domain odlm:TRPO ;
    rdfs:range xsd:string .

odlm:covarianceType a owl:DatatypeProperty ;
    rdfs:label "covarianceType" ;
    rdfs:domain odlm:GaussianMixtureModel ;
    rdfs:range xsd:string .

odlm:dataAvailability a owl:DatatypeProperty ;
    rdfs:label "dataAvailability" ;
    rdfs:domain odlm:ApplicationScenario ;
    rdfs:range xsd:string .

odlm:dendrogramOutput a owl:DatatypeProperty ;
    rdfs:label "dendrogramOutput" ;
    rdfs:domain odlm:HierarchicalClustering ;
    rdfs:range xsd:boolean .

odlm:dependsOnLabelQuality a owl:DatatypeProperty ;
    rdfs:label "dependsOnLabelQuality" ;
    rdfs:domain odlm:SupervisedLearning ;
    rdfs:range xsd:boolean .

odlm:dependsOnLabelQuantity a owl:DatatypeProperty ;
    rdfs:label "dependsOnLabelQuantity" ;
    rdfs:domain odlm:SupervisedLearning ;
    rdfs:range xsd:boolean .

odlm:deploymentSuitability a owl:DatatypeProperty ;
    rdfs:label "deploymentSuitability" ;
    rdfs:domain odlm:TRPO ;
    rdfs:range xsd:string .

odlm:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:domain odlm:LearningMethod ;
    rdfs:range xsd:string .

odlm:detectionLatency a owl:DatatypeProperty ;
    rdfs:label "detectionLatency" ;
    rdfs:domain odlm:AnomalyDetection ;
    rdfs:range xsd:double .

odlm:dictionarySize a owl:DatatypeProperty ;
    rdfs:label "dictionarySize" ;
    rdfs:domain odlm:SparseCoding ;
    rdfs:range xsd:int .

odlm:distanceMetric a owl:DatatypeProperty ;
    rdfs:label "distanceMetric" ;
    rdfs:domain odlm:HierarchicalClustering,
        odlm:KMeans ;
    rdfs:range xsd:string .

odlm:distributionAssumption a owl:DatatypeProperty ;
    rdfs:label "distributionAssumption" ;
    rdfs:domain odlm:GenerativeModel ;
    rdfs:range xsd:string .

odlm:domain a owl:DatatypeProperty ;
    rdfs:label "domain" ;
    rdfs:domain odlm:AlgorithmicTrading,
        odlm:ApplicationScenario,
        odlm:AutonomousDriving,
        odlm:GameAI,
        odlm:RobotControl ;
    rdfs:range xsd:string .

odlm:emissionDistribution a owl:DatatypeProperty ;
    rdfs:label "emissionDistribution" ;
    rdfs:domain odlm:HiddenMarkovModel ;
    rdfs:range xsd:string .

odlm:environmentComplexity a owl:DatatypeProperty ;
    rdfs:label "environmentComplexity" ;
    rdfs:domain odlm:GameAI ;
    rdfs:range xsd:string .

odlm:estimate a owl:ObjectProperty ;
    rdfs:label "estimate" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( odlm:GaussianMixtureModel odlm:QLearning ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( odlm:QValue odlm:Parameters ) ] .

odlm:evaluate a owl:ObjectProperty ;
    rdfs:label "evaluate" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( odlm:Critic odlm:ActorCritic ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( odlm:PolicyQuality odlm:ValueFunction ) ] .

odlm:evaluationMetric a owl:DatatypeProperty ;
    rdfs:label "evaluationMetric" ;
    rdfs:domain odlm:Classification,
        odlm:Regression ;
    rdfs:range xsd:string .

odlm:exaggeration a owl:DatatypeProperty ;
    rdfs:label "exaggeration" ;
    rdfs:domain odlm:TSNE ;
    rdfs:range xsd:double .

odlm:expressionNormalization a owl:DatatypeProperty ;
    rdfs:label "expressionNormalization" ;
    rdfs:domain odlm:GeneAnalysis ;
    rdfs:range xsd:boolean .

odlm:featureExtractor a owl:DatatypeProperty ;
    rdfs:label "featureExtractor" ;
    rdfs:domain odlm:ImageRecognition ;
    rdfs:range xsd:string .

odlm:featureViewCount a owl:DatatypeProperty ;
    rdfs:label "featureViewCount" ;
    rdfs:domain odlm:WebPageClassification ;
    rdfs:range xsd:int .

odlm:frequentPatternCount a owl:DatatypeProperty ;
    rdfs:label "frequentPatternCount" ;
    rdfs:domain odlm:FPGrowth ;
    rdfs:range xsd:int .

odlm:geneCount a owl:DatatypeProperty ;
    rdfs:label "geneCount" ;
    rdfs:domain odlm:GeneAnalysis ;
    rdfs:range xsd:int .

odlm:handlesHighDimensionalStateSpace a owl:DatatypeProperty ;
    rdfs:label "handlesHighDimensionalStateSpace" ;
    rdfs:domain odlm:DQN ;
    rdfs:range xsd:boolean .

odlm:hasHighValue a owl:DatatypeProperty ;
    rdfs:label "hasHighValue" ;
    rdfs:domain odlm:ReinforcementLearning,
        odlm:SemiSupervisedLearning,
        odlm:SupervisedLearning,
        odlm:UnsupervisedLearning ;
    rdfs:range xsd:boolean .

odlm:identify a owl:ObjectProperty ;
    rdfs:label "identify" ;
    rdfs:domain odlm:UnsupervisedLearning ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( odlm:Pattern odlm:Structure ) ] .

odlm:implementationComplexity a owl:DatatypeProperty ;
    rdfs:label "implementationComplexity" ;
    rdfs:domain odlm:PPO ;
    rdfs:range xsd:string .

odlm:includesAlgorithms a owl:DatatypeProperty ;
    rdfs:label "includesAlgorithms" ;
    rdfs:domain odlm:ReinforcementLearning,
        odlm:SemiSupervisedLearning,
        odlm:SupervisedLearning,
        odlm:UnsupervisedLearning ;
    rdfs:range xsd:boolean .

odlm:initializationMethod a owl:DatatypeProperty ;
    rdfs:label "initializationMethod" ;
    rdfs:domain odlm:KMeans ;
    rdfs:range xsd:string .

odlm:inputDataType a owl:DatatypeProperty ;
    rdfs:label "inputDataType" ;
    rdfs:domain odlm:Algorithm ;
    rdfs:range xsd:string .

odlm:inputModality a owl:DatatypeProperty ;
    rdfs:label "inputModality" ;
    rdfs:domain odlm:DQN ;
    rdfs:range xsd:string .

odlm:interact a owl:ObjectProperty ;
    rdfs:label "interact" ;
    rdfs:domain odlm:Agent ;
    rdfs:range odlm:Environment .

odlm:interactsWithEnvironment a owl:DatatypeProperty ;
    rdfs:label "interactsWithEnvironment" ;
    rdfs:domain odlm:ReinforcementLearning ;
    rdfs:range xsd:boolean .

odlm:interpretability a owl:DatatypeProperty ;
    rdfs:label "interpretability" ;
    rdfs:domain odlm:GenerativeModel ;
    rdfs:range xsd:string .

odlm:involvesTemporalDependency a owl:DatatypeProperty ;
    rdfs:label "involvesTemporalDependency" ;
    rdfs:domain odlm:SequentialDecisionMaking ;
    rdfs:range xsd:boolean .

odlm:itemSetSizeLimit a owl:DatatypeProperty ;
    rdfs:label "itemSetSizeLimit" ;
    rdfs:domain odlm:Apriori ;
    rdfs:range xsd:int .

odlm:kernelType a owl:DatatypeProperty ;
    rdfs:label "kernelType" ;
    rdfs:domain odlm:DensityEstimation,
        odlm:SupportVectorMachine ;
    rdfs:range xsd:string .

odlm:languageModelIntegration a owl:DatatypeProperty ;
    rdfs:label "languageModelIntegration" ;
    rdfs:domain odlm:SpeechRecognition ;
    rdfs:range xsd:boolean .

odlm:learn a owl:ObjectProperty ;
    rdfs:label "learn" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( odlm:SupervisedLearning odlm:SemiSupervisedLearning odlm:GenerativeModel odlm:UnsupervisedLearning odlm:ReinforcementLearning ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( odlm:Structure odlm:Pattern odlm:Label odlm:Policy odlm:JointDistribution ) ] .

odlm:learningParadigm a owl:DatatypeProperty ;
    rdfs:label "learningParadigm" ;
    rdfs:domain odlm:ReinforcementLearning,
        odlm:SemiSupervisedLearning,
        odlm:SupervisedLearning,
        odlm:UnsupervisedLearning ;
    rdfs:range xsd:string .

odlm:learningRate a owl:DatatypeProperty ;
    rdfs:label "learningRate" ;
    rdfs:domain odlm:TSNE ;
    rdfs:range xsd:double .

odlm:limit a owl:ObjectProperty ;
    rdfs:label "limit" ;
    rdfs:domain odlm:TRPO ;
    rdfs:range odlm:PolicyChange .

odlm:linguisticFeatures a owl:DatatypeProperty ;
    rdfs:label "linguisticFeatures" ;
    rdfs:domain odlm:TextAnalysis ;
    rdfs:range xsd:string .

odlm:linkageCriterion a owl:DatatypeProperty ;
    rdfs:label "linkageCriterion" ;
    rdfs:domain odlm:HierarchicalClustering ;
    rdfs:range xsd:string .

odlm:lossFunction a owl:DatatypeProperty ;
    rdfs:label "lossFunction" ;
    rdfs:domain odlm:LinearRegression ;
    rdfs:range xsd:string .

odlm:lossy a owl:DatatypeProperty ;
    rdfs:label "lossy" ;
    rdfs:domain odlm:DataCompression ;
    rdfs:range xsd:boolean .

odlm:maxDepth a owl:DatatypeProperty ;
    rdfs:label "maxDepth" ;
    rdfs:domain odlm:DecisionTree ;
    rdfs:range xsd:int .

odlm:maximize a owl:ObjectProperty ;
    rdfs:label "maximize" ;
    rdfs:domain odlm:ReinforcementLearning ;
    rdfs:range odlm:CumulativeReward .

odlm:minConfidence a owl:DatatypeProperty ;
    rdfs:label "minConfidence" ;
    rdfs:domain odlm:Apriori ;
    rdfs:range xsd:double .

odlm:minSupport a owl:DatatypeProperty ;
    rdfs:label "minSupport" ;
    rdfs:domain odlm:Apriori,
        odlm:FPGrowth ;
    rdfs:range xsd:double .

odlm:minimize a owl:ObjectProperty ;
    rdfs:label "minimize" ;
    rdfs:domain odlm:SupervisedLearning ;
    rdfs:range odlm:PredictionError .

odlm:modality a owl:DatatypeProperty ;
    rdfs:label "modality" ;
    rdfs:domain odlm:MedicalImageAnalysis ;
    rdfs:range xsd:string .

odlm:model a owl:ObjectProperty ;
    rdfs:label "model" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( odlm:GenerativeModel odlm:HiddenMarkovModel ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( odlm:JointDistribution odlm:TimeSeriesModeling ) ] .

