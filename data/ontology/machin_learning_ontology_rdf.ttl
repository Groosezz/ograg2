    rdfs:range xsd:string .

odlm:optimize a owl:ObjectProperty ;
    rdfs:label "optimize" ;
    rdfs:domain odlm:ActorCritic ;
    rdfs:range odlm:Policy .

odlm:output a owl:ObjectProperty ;
    rdfs:label "output" ;
    rdfs:domain odlm:Actor ;
    rdfs:range odlm:ActionProbabilityDistribution .

