    rdfs:label "modelFree" ;
    rdfs:domain odlm:QLearning ;
    rdfs:range xsd:boolean .

odlm:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain odlm:Algorithm,
        odlm:LearningMethod,
        odlm:Task ;
    rdfs:range xsd:string .

odlm:numberOfClusters a owl:DatatypeProperty ;
    rdfs:label "numberOfClusters" ;
    rdfs:domain odlm:KMeans ;
    rdfs:range xsd:int .

odlm:numberOfComponents a owl:DatatypeProperty ;
    rdfs:label "numberOfComponents" ;
    rdfs:domain odlm:GaussianMixtureModel,
        odlm:PCA ;
    rdfs:range xsd:int .

odlm:numberOfLayers a owl:DatatypeProperty ;
    rdfs:label "numberOfLayers" ;
    rdfs:domain odlm:NeuralNetwork ;
    rdfs:range xsd:int .

odlm:numberOfStates a owl:DatatypeProperty ;
    rdfs:label "numberOfStates" ;
    rdfs:domain odlm:HiddenMarkovModel ;
    rdfs:range xsd:int .

odlm:objective a owl:DatatypeProperty ;
    rdfs:label "objective" ;
    rdfs:domain odlm:SequentialDecisionMaking,
